{
    "version": 6,
    "configurePresets": [
        {
            "name": "common",
            "hidden": true,
            "binaryDir": "build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "On"
            }
        },
        {
            "name": "ninja-debug",
            "displayName": "Ninja Debug",
            "generator": "Ninja",
            "inherits": "common",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-Wall -Wextra -pedantic -O0 -g"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ninja-debug",
            "displayName": "Ninja Debug",
            "configuration": "Debug",
            "configurePreset": "ninja-debug"
        }
    ]
}