    "where"
    "while"
    "with"
    "::"
    "--"
    "++"


Grammar

    0 $accept: start $end

    1 start: declarations

    2 declarations: declarations declaration
    3             | ε

    4 declaration: variable-declaration
    5            | function-declaration

    6 variable-declaration: "let" IDENTIFIER ";"
    7                     | "let" IDENTIFIER ":" type ";"
    8                     | "let" IDENTIFIER "=" expression ";"
    9                     | "let" IDENTIFIER ":" type "=" expression ";"

   10 type: simple-type
   11     | type "&"
   12     | type "*"
   13     | type "[" "]"
   14     | type "*" "mutable"
   15     | type "[" "]" "mutable"

   16 simple-type: TYPE_NAME
   17            | TYPE_NAME "mutable"
   18            | "typeof" "(" expression ")"
   19            | "typeof" "(" expression ")" "mutable"

   20 function-declaration: "let" IDENTIFIER "(" function-parameter-list-opt ")" return-type-opt "=" compound-statement

   21 function-parameter-list-opt: function-parameter-list
   22                            | ε

   23 function-parameter-list: function-parameter
   24                        | function-parameter-list "," function-parameter

   25 function-parameter: IDENTIFIER
   26                   | IDENTIFIER ":" mode
   27                   | IDENTIFIER ":" type
   28                   | IDENTIFIER ":" mode type

   29 mode: "in"
   30     | "out"
   31     | "in" "out"
   32     | "move"

   33 return-type-opt: return-type
   34                | ε

   35 return-type: "->" type

   36 statements: statements statement
   37           | ε

   38 statement: expression ";"
   39          | assignment-statement
   40          | compound-statement
   41          | declaration

   42 assignment-statement: expression "=" expression ";"
   43                     | expression "<-" expression ";"
   44                     | expression "+=" expression ";"
   45                     | expression "-=" expression ";"
   46                     | expression "*=" expression ";"
   47                     | expression "%=" expression ";"
   48                     | expression "/=" expression ";"
   49                     | expression "//=" expression ";"
   50                     | expression "^=" expression ";"

   51 compound-statement: "{" statements "}"

   52 expression: primary-exression
   53           | binary-expression
   54           | unary-expression
   55           | absolute-value-expression
   56           | function-call-expression
   57           | array-index-expression

   58 primary-exression: literal
   59                  | "(" expression ")"

   60 literal: CHARACTER
   61        | COMPLEX
   62        | FLOAT
   63        | IDENTIFIER
   64        | INTEGER
   65        | STRING
   66        | "true"
   67        | "false"
   68        | "this"

   69 binary-expression: expression "or" expression
   70                  | expression "and" expression
   71                  | expression "==" expression
   72                  | expression "!=" expression
   73                  | expression "<" expression
   74                  | expression "<=" expression
   75                  | expression ">" expression
   76                  | expression ">=" expression
   77                  | expression "<=>" expression
   78                  | expression "+" expression
   79                  | expression "-" expression
   80                  | expression "*" expression
   81                  | expression "/" expression
   82                  | expression "//" expression
   83                  | expression "%" expression
   84                  | expression "^" expression
   85                  | expression "." expression

   86 unary-expression: expression "!"
   87                 | "not" expression
   88                 | "-" expression

   89 absolute-value-expression: "|" expression "|"

   90 function-call-expression: IDENTIFIER "(" expression-list-opt ")"
   91                         | function-call-expression "(" expression-list-opt ")"

   92 array-index-expression: IDENTIFIER "[" expression "]"
   93                       | function-call-expression "[" expression "]"
   94                       | array-index-expression "[" expression "]"

   95 expression-list-opt: expression-list
   96                    | ε

   97 expression-list: expression
   98                | expression-list "," expression


